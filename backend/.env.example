# Ce fichier sert de référence. Spring Boot ne le charge pas automatiquement.
DB_URL=jdbc:postgresql://localhost:5432/dexora_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Générer 64 octets en Base64 : openssl rand -base64 64
JWT_SECRET_KEY=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=1440000

FRONTEND_BASE_URL=http://localhost:5173
CERTIFICATE_PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SWAGGER_ENABLED=false
SWAGGER_PUBLIC=false
EMAIL_VERIFICATION_EXPOSE_DEV_LINK=false

MAIL_USERNAME=
MAIL_PASSWORD=
